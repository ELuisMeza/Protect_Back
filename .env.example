# Copiar a .env y completar con valores reales.
# El archivo .env no se versiona.

# Base de datos
DB_URL=jdbc:postgresql://localhost:5432/protec
DB_USERNAME=postgres
DB_PASSWORD=

# JWT (HS256 — mínimo 32 caracteres)
JWT_SECRET=
JWT_EXPIRATION_MS=86400000
JWT_COOKIE_NAME=access_token
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAME_SITE=Lax

# CORS (Frontend)
CORS_ALLOWED_ORIGINS=http://localhost:5175

# Green API (WhatsApp) — valores del panel https://console.green-api.com
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN=
GREEN_API_URL=https://api.green-api.com
GREEN_API_MEDIA_URL=https://media.green-api.com
GREEN_API_DEFAULT_COUNTRY_CODE=51

# JPA (opcionales)
JPA_SHOW_SQL=true
